if SHIELD_MKB_DONGLE
    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config ZMK_KEYBOARD_NAME
        default "MeKaBu"

    config ZMK_BLE
        default y

    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    # Max pair + 1 (+1 for peripheral)
    config BT_MAX_CONN
        default 7

    # Set this to the same number as BT_MAX_CONN
    config BT_MAX_PAIRED
    default 7


endif 

if SHIELD_MKB_L || SHIELD_MKB_R || SHIELD_MKB_DONGLE
    config ZMK_SPLIT
        default y

endif