
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define DEF 0
#define MAC 1
#define MARK 2
#define FUNC 3
#define MACFUNC 4
#define NUM 5
#define MOUSE 6
#define MOUSE_NUM 7
#define BT 8
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <150>;
    hold-trigger-on-release;
};

&trackball_right_listener { 
    mouse_only {
        layers = <MOUSE>, <MOUSE_NUM>;
        input-processors = <&zip_inertia>;
    };
    input-processors = <&zip_temp_layer_threshold MOUSE 5000>, <&zip_inertia>;
};

&trackball_scroller {
    layers = <MARK>;
    input-processors =
        <&zip_xy_scaler 1 16 &zip_xy_to_scroll_mapper>,
        <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_inertia>;
};

&trackball_left_listener {
  input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
                      <&zip_xy_scaler 1 2>, <&zip_xy_to_scroll_mapper>, 
                      <&zip_scroll_x_scaler 0 1>, <&zip_inertia>;
  scroller {
        layers = <MARK>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_y_scaler 0 1
            &zip_xy_scaler 1 16
        >, <&zip_inertia>;
    };
};

// マウスキー入力のXXXms後にマウスレイヤーを抜ける
&mkp_input_listener {
  input-processors = <&zip_temp_layer MOUSE 10000>;
};

&zip_temp_layer {
    excluded-positions = <
        0  // ESC
        9  // F(Prev)
        10 // W(Next)
        21 // S(左クリック)
        22 // H(中クリック)  
        23 // "(右クリック)
        24 // Shift
    >;

    require-prior-idle-ms = <200>;
};

/ {
zip_temp_layer_threshold: zip_temp_layer_threshold {
        compatible = "zmk,input-processor-temp-layer-threshold";
        #input-processor-cells = <2>;
        
        // AML発動に必要な累積移動量
        threshold = <250>;
        
        // 以下で指定したキー以外を押すとAML解除
        excluded-positions = <
            0  // ESC
            9  // F(Prev)
            10 // W(Next)
            21 // S(左クリック)
            22 // H(中クリック)  
            23 // "(右クリック)
            24 // Shift
        >;
        
        // キー入力から200ms間はAMLを発動しない
        require-prior-idle-ms = <200>;

        // 蓄積された移動量をリセットするまでの時間
        reset-timeout-ms = <5000>;
    };
};
/**************************************************************************/

/ {
    combos {
        compatible = "zmk,combos";

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        mo_scroll {
            bindings = <&mo MARK>;
            key-positions = <11 23>;
        };

        mo_mouse {
            bindings = <&mo MOUSE>;
            key-positions = <16 15>;
        };

        alt_space {
            bindings = <&kp LA(SPACE)>;
            key-positions = <40 41>;
        };

        combo_capslock {
            bindings = <&kp CAPS>;
            key-positions = <12 13 14>;
        };

        toggle_IME {
            bindings = <&kp LC(SPACE)>;
            key-positions = <36 45>;
        };

        LWin {
            bindings = <&kp LEFT_GUI>;
            key-positions = <24 36>;
        };

        Mo_Num {
            bindings = <&mo NUM>;
            key-positions = <39 40>;
        };

        tog_mac {
            bindings = <&tog MAC>;
            key-positions = <0 11>;
        };

        ctrl_space {
            bindings = <&kp LC(SPACE)>;
            key-positions = <39 42>;
        };
    };

    /**************************************************************************/

    macros {
        // for Auto Shift

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    /**************************************************************************/

    behaviors {
        td_bspc: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt FUNC BSPC>, <&kp BSPC>;
        };

        td_spc: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt FUNC SPACE>, <&kp SPACE>;
        };

        td_bspc_mac: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt MACFUNC BSPC>, <&kp BSPC>;
        };

        td_spc_mac: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt MACFUNC SPACE>, <&kp SPACE>;
        };

        mouse_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <25>;
        };

        mod_mkp: mod_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_MKP";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping_term_ms = <180>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&shifted>, <&kp>;
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        ime_alt: ime_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "IME_ALT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        tog_on: tog_layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "on";
            label = "TOG_ON";
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll_left_right: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    /**************************************************************************/

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESC            &kp Q     &kp L      &kp U     &kp COMMA  &lt NUM PERIOD      &kp F         &kp W     &kp R      &kp Y      &kp P      &kp SLASH
&mt LCTRL TAB      &kp E     &kp I      &kp A     &kp O      &kp MINUS           &kp K         &kp T     &kp N      &kp S      &kp H      &mt RCTRL SQT
&kp LSHFT          &kp J     &kp X      &kp C     &kp V      &kp EQUAL           &kp G         &kp D     &kp M      &kp Z      &kp B      &mt RSHFT SEMI
&ime_alt LALT F14  &kp LGUI  &kp LALT             &td_spc    &lt MARK SPACE      &lt MARK RET  &td_bspc             &tog MOUSE_NUM   &kp K_APP  &ime_alt RALT F13
&kp LEFT           &kp UP    &kp RET    &kp DOWN  &kp RIGHT                                    &kp HOME  &kp PG_UP  &kp TAB  &kp PG_DN  &kp END
                                        &none                                                            &none
            >;
            sensor-bindings = <&scroll_up_down  &inc_dec_kp LEFT RIGHT>;
        };

        mac_layer {
            label = "Mac";
            bindings = <
&kp ESC            &kp Q     &kp L      &kp U     &kp COMMA    &kp PERIOD          &kp F         &kp W         &kp R      &kp Y      &kp P      &kp SLASH
&mt LCTRL TAB      &kp E     &kp I      &kp A     &kp O        &kp MINUS           &kp K         &kp T         &kp N      &kp S      &kp H      &mt RCTRL SQT
&kp LSHFT          &kp Z     &kp X      &kp C     &kp V        &kp EQUAL           &kp G         &kp D         &kp M      &kp J      &kp B      &mt RSHFT SEMI
&ime_alt LALT F14  &kp LGUI  &kp LALT             &td_spc_mac  &lt MARK SPACE      &lt MARK RET  &td_bspc_mac             &tog NUM   &kp K_APP  &ime_alt RALT F13
&kp LEFT           &kp UP    &kp RET    &kp DOWN  &kp RIGHT                                      &kp HOME      &kp PG_UP  &kp TAB  &kp PG_DN  &kp END
                                        &none                                                                  &none
            >;
            sensor-bindings = <&scroll_up_down &scroll_left_right>;
        };

        mark_layer {
            label = "Mark";
            bindings = <
&kp GRAVE  &kp LS(N1)     &kp LS(N2)  &kp LS(N3)  &kp LS(N4)     &kp LS(N5)          &kp LS(N6)     &kp LS(N7)     &kp LS(N8)  &kp LS(N9)    &kp LS(N0)  &kp LS(SLASH)
&kp TAB    &kp MINUS      &kp LBKT    &kp RBKT    &kp LS(COMMA)  &kp LS(PERIOD)      &kp LS(SEMI)   &kp LEFT       &kp DOWN    &kp UP        &kp RIGHT   &kp LS(SQT)
&kp LSHFT  &kp LS(MINUS)  &kp LBRC    &kp RBRC    &kp LS(N9)     &kp LS(N0)          &kp GRAVE      &kp LS(GRAVE)  &kp BSLH    &kp LS(BSLH)  &kp EQUAL   &kp LS(EQUAL)
&kp F16    &kp F15        &kp LALT                &trans         &kp SPACE           &kp BACKSPACE  &kp DEL                 &kp LEFT      &kp DOWN    &kp RIGHT
&kp LEFT   &kp UP         &kp RET     &kp DOWN    &kp RIGHT                                         &kp HOME    &kp PG_UP   &kp TAB     &kp PG_DN   &kp END
                                      &none                                                                     &none
            >;
             sensor-bindings = <&scroll_up_down &scroll_left_right>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&kp ESC     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp F6  &kp F7            &kp F8         &kp F9          &kp F10            &kp F11
&caps_word  &kp LC(Y)  &none      &none      &none      &none          &none   &kp LC(LG(LEFT))  &kp DOWN       &kp UP          &kp LC(LG(RIGHT))  &kp F12
&kp LC(S)   &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LG(V)      &none   &kp HOME          &kp LC(LG(D))  &kp LC(LG(F4))  &kp END            &kp LS(LG(S))
&mo BT      &trans     &kp LALT              &trans     &trans         &trans  &trans               &trans     &trans     &mo BT
&kp LEFT    &kp UP     &kp RET  &kp DOWN   &kp RIGHT                           &kp HOME  &kp PG_UP  &kp TAB  &kp PG_DN  &kp END
                                  &none                                                  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        macfunction_layer {
            label = "FncM";
            bindings = <
&kp ESC     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp F6  &kp F7    &kp F8     &kp F9     &kp F10    &kp F11
&caps_word  &kp LG(Y)  &none      &none      &none      &none          &none   &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp F12
&kp LG(S)   &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(V)      &none   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp LS(LG(S))
&mo BT      &trans     &kp LALT              &trans     &trans         &trans  &trans               &trans     &trans     &mo BT
&kp LEFT    &kp UP     &kp RET  &kp DOWN   &kp RIGHT                         &kp HOME  &kp PG_UP  &kp TAB  &kp PG_DN  &kp END
                                  &none                                                  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        num_layer {
            label = "Num";
            bindings = <
&kp KP_NUM  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4             &kp KP_N5                  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0        &kp EQUAL
&trans      &as A      &as B      &as C      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS      &kp PLUS   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_ASTERISK  &kp COMMA
&trans      &as D      &as E      &as F      &none                 &kp X                      &kp MINUS  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_SLASH     &kp KP_DOT
&trans      &trans     &trans                &trans                &trans                     &kp ENTER  &kp KP_N0             &trans     &trans           &trans
&kp LEFT    &kp UP     &kp RET    &kp DOWN   &kp RIGHT                                                   &kp HOME   &kp PG_UP  &kp TAB  &kp PG_DN        &kp END
                                  &none                                                                             &none
            >;
            sensor-bindings = <&scroll_up_down &scroll_left_right>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&tog_off MOUSE  &trans  &trans     &trans    &trans     &trans              &trans     &trans    &trans     &trans     &mod_mkp LEFT_SHIFT MB4  &mod_mkp LEFT_CONTROL MB5
&trans          &trans  &trans     &trans    &trans     &trans              &trans     &trans    &trans     &mkp MB1   &mkp MB3                 &mkp MB2
&trans          &trans  &trans     &trans    &trans     &trans              &trans     &trans    &trans     &trans     &trans                   &trans
&trans          &trans  &trans               &trans     &trans              &trans     &trans               &trans     &trans                   &trans
&kp LEFT        &kp UP  &kp RET    &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp TAB  &kp PG_DN    &kp END
                                   &none                                                              &none
            >;
            sensor-bindings = <&scroll_up_down &scroll_left_right>;
        };

        mouse_num_layer {
            label = "Mouse";
            bindings = <
&to DEF   &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans  &trans              &trans   &trans    &trans     &trans     &mod_mkp LEFT_SHIFT MB4  &mod_mkp LEFT_CONTROL MB5
&trans    &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans  &trans              &trans   &trans    &trans     &mkp MB1   &mkp MB3                 &mkp MB2
&trans    &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans  &trans              &trans   &trans    &trans     &trans     &trans                   &trans
&trans    &kp KP_N0  &kp KP_DOT            &trans   &kp RET             &trans   &trans               &trans     &trans                   &trans
&kp LEFT   &kp UP  &kp RET    &kp DOWN  &kp RIGHT                                      &kp HOME  &kp PG_UP  &kp TAB  &kp PG_DN  &kp END
                                   &none                                                              &none
            >;
            sensor-bindings = <&scroll_up_down &scroll_left_right>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR_ALL  &trans    &trans     &trans     &trans     &trans         &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4 
&trans          &trans    &trans     &trans     &trans     &trans         &trans      &trans        &trans        &trans        &trans        &trans
&trans          &trans    &trans     &trans     &trans     &trans         &trans      &trans        &trans        &trans        &trans        &trans
&trans          &trans    &trans                &trans     &trans         &trans      &trans        &trans        &trans        &trans
&kp LEFT    &kp UP        &kp RET       &kp DOWN      &kp RIGHT                                       &kp HOME  &kp PG_UP  &kp TAB  &kp PG_DN  &kp END
                                        &none                                                                   &none
            >;
            sensor-bindings = <&scroll_up_down &scroll_left_right>;
        };
    };
};
